<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Two builds from one project, because Autodesk changed the add-in
      runtime between these versions:
        - Revit 2024 add-ins run on .NET Framework 4.8  → net48
        - Revit 2025 AND 2026 add-ins both run on .NET 8 → net8.0-windows
          (Autodesk didn't break the public API surface this add-in uses
          between 2025 and 2026, so ONE net8.0-windows build covers both —
          install.ps1 copies that same DLL into both versions' Addins
          folders. If something really did change between them, the fix is
          to build net8.0-windows twice with a different RevitInstallDir
          each time, not to add a third TFM here.)
    -->
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <AssemblyName>BravesBimFieldImporter</AssemblyName>
    <RootNamespace>BravesBimFieldImporter</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>

    <!--
      Adjust these if your Revit install isn't in the default location, e.g.
      by passing /p:RevitInstallDir="D:\Autodesk\Revit 2025" to msbuild, or
      editing the defaults below. net8.0-windows defaults to the 2025 folder
      since that's the one actually being compiled against (see note above).
    -->
    <RevitInstallDir Condition="'$(RevitInstallDir)'=='' And '$(TargetFramework)'=='net48'">C:\Program Files\Autodesk\Revit 2024</RevitInstallDir>
    <RevitInstallDir Condition="'$(RevitInstallDir)'=='' And '$(TargetFramework)'=='net8.0-windows'">C:\Program Files\Autodesk\Revit 2025</RevitInstallDir>
  </PropertyGroup>

  <!-- net8.0-windows pulls in WinForms/WPF through the Windows Desktop
       shared framework instead of the raw assembly References net48 uses
       below — mixing both approaches on the same TFM causes duplicate-type
       build errors, so this is net8.0-windows-only. -->
  <PropertyGroup Condition="'$(TargetFramework)'=='net8.0-windows'">
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Include="firebase.config.json.example">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Ribbon button icons (Braves logo + a small badge per function) — baked
       into the DLL so there's nothing extra to copy when installing. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\*.png" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)'=='net48'">
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Net.Http" />
    <!-- PushButtonData images are WPF ImageSource (BitmapImage). -->
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <!-- These ship with Revit itself — never redistribute them, hence Private=false. -->
  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitInstallDir)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitInstallDir)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
