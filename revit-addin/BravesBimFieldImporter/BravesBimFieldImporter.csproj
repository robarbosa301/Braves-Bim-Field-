<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Two builds from one project, because Autodesk changed the add-in
      runtime between these versions:
        - Revit 2024 add-ins run on .NET Framework 4.8  → net48
        - Revit 2025 AND 2026 add-ins both run on .NET 8 → net8.0-windows
          (Autodesk didn't break the public API surface this add-in uses
          between 2025 and 2026, so ONE net8.0-windows build covers both —
          install.ps1 copies that same DLL into both versions' Addins
          folders. If something really did change between them, the fix is
          to build net8.0-windows twice, once per RevitAPI package version
          below — see the PackageReference ItemGroups further down — not to
          add a third TFM here.)
    -->
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <AssemblyName>BravesBimFieldImporter</AssemblyName>
    <RootNamespace>BravesBimFieldImporter</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <!-- net8.0-windows pulls in WinForms/WPF through the Windows Desktop
       shared framework instead of the raw assembly References net48 uses
       below — mixing both approaches on the same TFM causes duplicate-type
       build errors, so this is net8.0-windows-only. -->
  <PropertyGroup Condition="'$(TargetFramework)'=='net8.0-windows'">
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!--
    RevitAPI/RevitAPIUI from NuGet instead of a HintPath into a local Revit
    install — Nice3point.Revit.Api.* (community-maintained, one of the
    standard ways Revit plugins are built in CI; see
    https://github.com/Nice3point/RevitTemplates) republishes the same DLLs
    Revit itself ships, versioned by year, purely for compiling against.
    This is what makes it possible to build this add-in on a machine (or a
    CI runner) that has never had Revit installed — see
    .github/workflows/revit-addin-build.yml at the repo root, which builds
    both TFMs on every push using exactly this.

    net8.0-windows is compiled against the 2025 package on purpose (not
    2026) — same reasoning as the TargetFrameworks comment above: Autodesk
    didn't break this add-in's slice of the API between 2025 and 2026, so
    compiling against the older of the two is the safer bet (anything it
    can see was already there in 2025) and the one resulting DLL runs on
    both. ExcludeAssets="runtime" is the PackageReference equivalent of the
    old Reference/Private=false — compile against it, but never copy it
    into the add-in's own output (Revit already has it loaded; shipping a
    second copy is actively wrong, not just extra).
  -->
  <ItemGroup Condition="'$(TargetFramework)'=='net48'">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2024.3.30" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2024.3.30" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)'=='net8.0-windows'">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2025.4.20" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2025.4.20" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <None Include="firebase.config.json.example">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Ribbon button icons (Braves logo + a small badge per function) — baked
       into the DLL so there's nothing extra to copy when installing. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\*.png" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)'=='net48'">
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Net.Http" />
    <!-- PushButtonData images are WPF ImageSource (BitmapImage). -->
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

</Project>
