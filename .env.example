# Copie este arquivo para ".env" e preencha com as credenciais do seu projeto
# Firebase (Configurações do projeto > Geral > Seus apps > SDK setup and configuration).
# Sem essas variáveis o app funciona normalmente, mas cada dispositivo salva
# só localmente (sem sincronização entre tablet/celular).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
